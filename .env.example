# Copy to .env for local overrides. Never commit real secrets.

# Port the server listens on (Railway sets this automatically)
PORT=3000

# Session cookie signing secret — set a strong random value in production
SESSION_SECRET=change-me-in-production

# Set to "production" to enable secure (HTTPS-only) session cookies
NODE_ENV=development

# Number of reverse-proxy hops in front of the app (Railway = 1). Leave unset
# locally so a direct client can't spoof its IP via X-Forwarded-For.
TRUST_PROXY=1
